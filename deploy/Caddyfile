:{$PORT:80} {
	root * /srv
	encode gzip zstd
	file_server

	# long cache for fingerprintable static assets, light cache for the page itself
	@assets path *.png *.svg *.ico *.webmanifest *.woff2 *.woff
	header @assets Cache-Control "public, max-age=604800"
	@page not path *.png *.svg *.ico *.webmanifest *.woff2 *.woff
	header @page Cache-Control "public, max-age=300"

	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	# Everything is self-hosted (fonts included); inline styles/scripts are part of the single-file page.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	header X-Frame-Options "DENY"
	header Permissions-Policy "camera=(), microphone=(), geolocation=()"
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
