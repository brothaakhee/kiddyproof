<plist version="1.0">
<!-- Hardened-runtime entitlements. Deliberately EMPTY: the suppressing CGEventTap
     needs the parent-granted Accessibility TCC permission, not an entitlement, and
     the app must NOT be sandboxed (CGEventTapCreate returns NULL under the sandbox).
     Sparkle 2.x needs no extra entitlements in a non-sandboxed app. -->
<dict/>
</plist>
