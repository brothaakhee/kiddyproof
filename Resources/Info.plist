<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>kiddyproof</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>app.kiddyproof.kiddyproof</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>kiddyproof</string>
	<key>CFBundleDisplayName</key>
	<string>kiddyproof</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__BUILD__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Menu-bar agent: no Dock icon. NEVER LSBackgroundOnly — that silently breaks
	     CGEventTapCreate on Sequoia even with Accessibility granted. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Deep link for one-click activation after purchase: the web /activate page
	     hands the signed key straight to the app as kiddyproof://activate?key=… so
	     a buyer never copies anything. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.kiddyproof.activation</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kiddyproof</string>
			</array>
		</dict>
	</array>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 kiddyproof. Blocks input locally; never phones home.</string>
	<!-- Sparkle update channel (direct-download app; not sandboxed / not MAS). -->
	<key>SUFeedURL</key>
	<string>https://kiddyproof.app/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>Njo3rVpOLp8W9Ob33vRhQlwQQ6yXTwrIC2gpdDxyx5M=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
